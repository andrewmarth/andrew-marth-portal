diff --git a/packages/lib/server-only/pdf/envelope-id-frame.ts b/packages/lib/server-only/pdf/envelope-id-frame.ts
new file mode 100644
index 0000000..934cac9
--- /dev/null
+++ b/packages/lib/server-only/pdf/envelope-id-frame.ts
@@ -0,0 +1,91 @@
+import Konva from 'konva';
+
+/**
+ * Andrew Marth Real Estate: a rounded frame around each signed signature and initials field, with "Signed by:"
+ * notched into its top border and, on signatures only, the envelope ID notched into its bottom border (like DocuSign's). Drawn into the
+ * export overlay, so it's part of the PDF before it's sealed.
+ */
+type FramedField = {
+  type: string;
+  inserted: boolean;
+  envelopeId: string;
+  positionX: unknown;
+  positionY: unknown;
+  width: unknown;
+  height: unknown;
+};
+
+// The portal theme's green (--olive)
+const FRAME_COLOR = '#4e513e';
+const FONT_FAMILY = 'Inter';
+
+// "envelope_kdhsmrtuvwxyzabc" -> "KDHSMRTUVWXYZABC" (the ID's letters are all lowercase, so it reads back exactly)
+export const envelopeIdLabel = (envelopeId: string) => envelopeId.replace(/^envelope_/, '').toUpperCase();
+
+export const addEnvelopeIdFrames = (layer: Konva.Layer, fields: FramedField[], pageWidth: number, pageHeight: number) => {
+  for (const field of fields) {
+    if (!field.inserted || (field.type !== 'SIGNATURE' && field.type !== 'INITIALS')) {
+      continue;
+    }
+
+    const fieldX = pageWidth * (Number(field.positionX) / 100);
+    const fieldW = pageWidth * (Number(field.width) / 100);
+    const y = pageHeight * (Number(field.positionY) / 100);
+    const h = pageHeight * (Number(field.height) / 100);
+    const radius = Math.min(6, h / 4, fieldW / 4);
+    const pad = radius + 2;
+
+    // The labels share one size: up to 7pt, smaller to fit a short or narrow field, but never under 5pt (a field too
+    // narrow for its labels gets a frame wider than itself, centered on it, so they stay readable)
+    const top = 'Signed by:';
+    const bottom = field.type === 'SIGNATURE' ? envelopeIdLabel(field.envelopeId) : '';
+    const probe = new Konva.Text({ text: bottom.length > top.length ? bottom : top, fontSize: 10, fontFamily: FONT_FAMILY });
+    const perPoint = probe.width() / 10;
+    probe.destroy();
+    const fontSize = Math.max(5, Math.min(7, h * 0.22, (fieldW - 2 * pad - 4) / perPoint));
+    const w = Math.max(fieldW, perPoint * fontSize + 2 * pad + 4);
+    const x = fieldX - (w - fieldW) / 2;
+
+    const label = (text: string, labelY: number) =>
+      new Konva.Text({ text, x: x + pad + 2, y: labelY - fontSize / 2, fontSize, fontFamily: FONT_FAMILY, fill: FRAME_COLOR });
+    const topLabel = label(top, y);
+    const bottomLabel = label(bottom, y + h);
+
+    // The notches: each border line stops 2pt before its label and picks up 2pt after it
+    const topGap = [x + pad, x + pad + topLabel.width() + 4];
+    const bottomGap = bottom ? [x + pad, x + pad + bottomLabel.width() + 4] : [x + pad, x + pad];
+
+    const frame = new Konva.Shape({
+      stroke: FRAME_COLOR,
+      strokeWidth: 1,
+      sceneFunc: (ctx, shape) => {
+        ctx.beginPath();
+        ctx.moveTo(topGap[1], y);
+        ctx.lineTo(x + w - radius, y);
+        ctx.arcTo(x + w, y, x + w, y + radius, radius);
+        ctx.lineTo(x + w, y + h - radius);
+        ctx.arcTo(x + w, y + h, x + w - radius, y + h, radius);
+        ctx.lineTo(bottomGap[1], y + h);
+        ctx.moveTo(bottomGap[0], y + h);
+        ctx.lineTo(x + radius, y + h);
+        ctx.arcTo(x, y + h, x, y + h - radius, radius);
+        ctx.lineTo(x, y + radius);
+        ctx.arcTo(x, y, x + radius, y, radius);
+        ctx.lineTo(topGap[0], y);
+        ctx.strokeShape(shape);
+      },
+    });
+
+    // White behind each label, so a line on the page under it (like the signature line) doesn't run through it
+    const backing = (text: Konva.Text) =>
+      new Konva.Rect({ x: text.x() - 2, y: text.y(), width: text.width() + 4, height: text.height(), fill: '#ffffff' });
+
+    layer.add(frame, backing(topLabel), topLabel);
+
+    if (bottom) {
+      layer.add(backing(bottomLabel), bottomLabel);
+    } else {
+      bottomLabel.destroy();
+    }
+  }
+};
diff --git a/packages/lib/server-only/pdf/export-field-style.ts b/packages/lib/server-only/pdf/export-field-style.ts
new file mode 100644
index 0000000..d07c9ad
--- /dev/null
+++ b/packages/lib/server-only/pdf/export-field-style.ts
@@ -0,0 +1,78 @@
+import fs from 'node:fs';
+import path from 'node:path';
+
+import { Canvas, FontLibrary } from '@documenso/skia-canvas';
+import Konva from 'konva';
+
+/**
+ * Andrew Marth Real Estate: how signed fields look in the finished PDF. Every field's ink is blue; name, email,
+ * date, text and number fields are Arial bold italic, while signatures and initials keep their usual fonts (and a
+ * drawn signature is re-inked blue).
+ */
+export const INK_COLOR = '#00208e';
+
+const TEXT_FIELD_TYPES = ['NAME', 'EMAIL', 'DATE', 'TEXT', 'NUMBER'];
+
+// Arial itself isn't free to ship: Liberation Sans (the Docker image's font-liberation package) has Arial's exact
+// letter widths, so it's registered under the name "Arial"
+const LIBERATION_DIR = '/usr/share/fonts/liberation';
+const ARIAL_FILES = ['Regular', 'Bold', 'Italic', 'BoldItalic'].map((style) => path.join(LIBERATION_DIR, `LiberationSans-${style}.ttf`));
+
+const ensureArial = () => {
+  if (!FontLibrary.has('Arial') && ARIAL_FILES.every((file) => fs.existsSync(file))) {
+    // eslint-disable-next-line react-hooks/rules-of-hooks
+    FontLibrary.use({ Arial: ARIAL_FILES });
+  }
+};
+
+// A drawn signature: the same strokes, in blue
+const reinkImage = (node: Konva.Image) => {
+  // eslint-disable-next-line @typescript-eslint/no-explicit-any
+  const source = node.image() as any;
+
+  if (!source || !source.width || !source.height) {
+    return;
+  }
+
+  const canvas = new Canvas(source.width, source.height);
+  const ctx = canvas.getContext('2d');
+
+  ctx.drawImage(source, 0, 0);
+  ctx.globalCompositeOperation = 'source-in';
+  ctx.fillStyle = INK_COLOR;
+  ctx.fillRect(0, 0, source.width, source.height);
+
+  // eslint-disable-next-line @typescript-eslint/consistent-type-assertions
+  node.image(canvas as unknown as HTMLCanvasElement);
+};
+
+export const styleExportedField = (fieldGroup: Konva.Group | undefined, fieldType: string) => {
+  if (!fieldGroup) {
+    return;
+  }
+
+  const isTextField = TEXT_FIELD_TYPES.includes(fieldType);
+
+  if (isTextField) {
+    ensureArial();
+  }
+
+  for (const node of fieldGroup.find('Text')) {
+    const text = node as Konva.Text;
+
+    text.fill(INK_COLOR);
+
+    if (isTextField) {
+      text.fontFamily('Arial, "Noto Sans", sans-serif');
+      text.fontStyle('italic bold');
+      // (no variant: Konva would add "normal" after "bold", and the canvas then drops the italic)
+      text.fontVariant('');
+    }
+  }
+
+  if (fieldType === 'SIGNATURE') {
+    for (const node of fieldGroup.find('Image')) {
+      reinkImage(node as Konva.Image);
+    }
+  }
+};
