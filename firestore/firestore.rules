rules_version = '2';

// The portal never reads or writes Firestore from the browser: everything goes through the Portal API
// (a Cloud Function using a service account, which these rules don't apply to). So no client access at all.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
