@@ -0,0 +1,57 @@
+/**
+ * MarthSign: the portal's header (logo, Back, Sign Out) and hero, drawn above the signing screen. The portal shows
+ * this page full-screen, so the whole thing scrolls as one page. Back and Sign Out are the portal's to do: they're
+ * asked for with a message to it (styles: packages/ui/styles/theme.css, .ms-*).
+ */
+const askPortal = (action: 'marthsign-back' | 'marthsign-sign-out') => window.parent.postMessage({ action }, '*');
+
+export const MarthSignHero = () => (
+  <header className="ms-hero">
+    <video
+      className="ms-hero-video"
+      poster="https://andrewmarth.com/images/banner_poster.webp"
+      autoPlay
+      loop
+      muted
+      playsInline
+      aria-hidden="true"
+    >
+      <source src="https://andrewmarth.com/images/banner_web.mp4" type="video/mp4" />
+    </video>
+    <div className="ms-hero-overlay" />
+
+    <div className="ms-top-bar">
+      <a href="https://andrewmarth.com" target="_top" aria-label="Andrew Marth Real Estate">
+        <img
+          src="https://andrewmarth.com/images/andrew_marth_logo_alt.webp"
+          alt="Andrew Marth Real Estate Agent"
+          width={1600}
+          height={376}
+        />
+      </a>
+      <div className="ms-top-actions">
+        <button type="button" className="ms-pill" onClick={() => askPortal('marthsign-back')}>
+          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
+            <path d="m12 19-7-7 7-7" />
+            <path d="M19 12H5" />
+          </svg>
+          Back
+        </button>
+        <button type="button" className="ms-pill" onClick={() => askPortal('marthsign-sign-out')}>
+          Sign Out
+          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
+            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
+            <path d="m16 17 5-5-5-5" />
+            <path d="M21 12H9" />
+          </svg>
+        </button>
+      </div>
+    </div>
+
+    <div className="ms-hero-content">
+      <span className="ms-hero-eyebrow">Signature Needed</span>
+      <h1>Sign Now</h1>
+      <p className="ms-hero-sub">Review the document and sign where it’s marked.</p>
+    </div>
+  </header>
+);
