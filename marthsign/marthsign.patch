+/* --- MarthSign: the portal's header (logo, Back, Sign Out) and hero, above the signing screen --- */
+@font-face {
+  font-family: 'Bricolage Grotesque';
+  font-style: normal;
+  font-weight: 400 800;
+  font-display: swap;
+  src: url(https://fonts.gstatic.com/s/bricolagegrotesque/v9/3y9K6as8bTXq_nANBjzKo3IeZx8z6up5BeSl9D4dj_x9PpZBMlGIInE.woff2) format('woff2');
+}
+@font-face {
+  font-family: 'Familjen Grotesk';
+  font-style: normal;
+  font-weight: 400 700;
+  font-display: swap;
+  src: url(https://fonts.gstatic.com/s/familjengrotesk/v11/Qw3GZR9ZHiDnImG6-NEMQ41wby8WbHoEjw.woff2) format('woff2');
+}
+.ms-page { background: #e9e2d8; }
+.ms-hero {
+  position: relative;
+  overflow: hidden;
+  background-color: #4e513e;
+  color: #e9e2d8;
+  text-align: center;
+  font-family: 'Familjen Grotesk', sans-serif;
+  line-height: 1.6;
+  padding: calc(env(safe-area-inset-top, 0px) + 22px) 20px 40px 20px;
+}
+.ms-hero-video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: 0; }
+.ms-hero-overlay {
+  position: absolute;
+  inset: 0;
+  z-index: 1;
+  background:
+    radial-gradient(ellipse at center, rgba(78, 81, 62, 0.55) 0%, rgba(78, 81, 62, 0.85) 75%),
+    linear-gradient(180deg, rgba(14, 42, 59, 0.3) 0%, rgba(78, 81, 62, 0.35) 55%, rgba(79, 45, 44, 0.75) 100%);
+}
+.ms-top-bar {
+  position: relative;
+  z-index: 2;
+  max-width: 900px;
+  margin: 0 auto 44px auto;
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 12px;
+}
+.ms-top-bar img { height: 34px; width: auto; display: block; filter: drop-shadow(0 2px 8px rgba(0, 0, 0, 0.35)); }
+.ms-top-actions { display: flex; align-items: center; gap: 10px; }
+.ms-pill {
+  display: inline-flex;
+  justify-content: center;
+  align-items: center;
+  white-space: nowrap;
+  gap: 8px;
+  min-height: 40px;
+  padding: 8px 18px;
+  border: 2px solid rgba(233, 226, 216, 0.7);
+  border-radius: 999px;
+  background: rgba(14, 42, 59, 0.25);
+  color: #e9e2d8;
+  font-family: inherit;
+  font-size: 0.9rem;
+  font-weight: bold;
+  cursor: pointer;
+  backdrop-filter: blur(4px);
+  -webkit-backdrop-filter: blur(4px);
+  transition: background-color 0.25s ease, border-color 0.25s ease;
+}
+.ms-pill svg { width: 16px; height: 16px; }
+@media (hover: hover) { .ms-pill:hover { background: #9a5d40; border-color: #9a5d40; } }
+.ms-pill:focus-visible { outline: 3px solid #c09050; outline-offset: 3px; }
+.ms-hero-content { position: relative; z-index: 2; }
+.ms-hero-eyebrow {
+  display: inline-flex;
+  align-items: center;
+  gap: 12px;
+  font-size: 0.8rem;
+  font-weight: 700;
+  letter-spacing: 3px;
+  text-transform: uppercase;
+  color: #c09050;
+  margin-bottom: 10px;
+}
+.ms-hero-eyebrow::before, .ms-hero-eyebrow::after { content: ''; width: 24px; height: 2px; background: currentColor; }
+.ms-hero h1 {
+  font-family: 'Bricolage Grotesque', sans-serif;
+  font-weight: 700;
+  font-size: clamp(2.2rem, 7vw, 3.4rem);
+  line-height: 1.05;
+  text-shadow: 0 2px 12px rgba(0, 0, 0, 0.3);
+}
+.ms-hero-sub { margin-top: 10px; font-size: 1.05rem; opacity: 0.9; }
+@media (max-width: 600px) {
+  .ms-top-bar { margin-bottom: 34px; }
+  .ms-top-bar img { height: 28px; }
+  .ms-top-actions { gap: 8px; }
+  .ms-pill { padding: 8px 13px; gap: 6px; font-size: 0.85rem; }
+}
