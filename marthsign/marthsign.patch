diff --git a/docker/Dockerfile b/docker/Dockerfile
index 22cad2e..18feea2 100644
--- a/docker/Dockerfile
+++ b/docker/Dockerfile
@@ -5,6 +5,9 @@ FROM node:24-alpine3.23 AS base
 
 RUN apk add --no-cache openssl
 RUN apk add --no-cache font-freefont
+# MarthSign: Arial, for signed text fields. From Microsoft's free core fonts package (the one Linux distributions'
+# installers use), checked against its known SHA-256 before it's unpacked.
+RUN apk add --no-cache --virtual .arial curl cabextract   && curl -fsSL -o /tmp/arial32.exe https://downloads.sourceforge.net/corefonts/arial32.exe   && echo "85297a4d146e9c87ac6f74822734bdee5f4b2a722d7eaa584b7f2cbf76f478f6  /tmp/arial32.exe" | sha256sum -c -   && mkdir -p /usr/share/fonts/arial   && cabextract -q -L -d /usr/share/fonts/arial /tmp/arial32.exe   && find /usr/share/fonts/arial -type f ! -name "*.ttf" -delete   && test -f /usr/share/fonts/arial/arialbi.ttf   && rm /tmp/arial32.exe && apk del .arial
 
 
 ###########################
diff --git a/marthsign-rebrand.sh b/marthsign-rebrand.sh
new file mode 100644
index 0000000..d3198de
--- /dev/null
+++ b/marthsign-rebrand.sh
@@ -0,0 +1,18 @@
+#!/usr/bin/env bash
+# MarthSign: the app's name, everywhere it's written in the app (screens, page titles, the PDFs' signing reason and
+# certificate, the disclosure, translations), and its website link becomes andrewmarth.com. Cloud Build runs this
+# before building the image (see cloudbuild.yaml).
+#
+# Only the capitalized name changes: the lowercase one is the code's own (package names like @documenso/lib, and
+# addresses the database and license check depend on), so it's left alone. Every file gets the same change, so
+# names in the code that contain it still match each other.
+set -euo pipefail
+
+find apps/remix packages \( -name node_modules -o -name app-tests \) -prune -o -type f \
+  \( -name '*.ts' -o -name '*.tsx' -o -name '*.po' -o -name '*.json' -o -name '*.webmanifest' -o -name '*.html' \) \
+  -print0 | xargs -0 sed -i -e 's/Documenso/MarthSign/g' -e 's#https://documenso\.com#https://andrewmarth.com#g'
+
+# The link-preview picture is the old brand's (and nothing links to it now)
+rm -f apps/remix/public/opengraph-image.jpg packages/assets/opengraph-image.jpg
+
+echo "MarthSign: renamed"
